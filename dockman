# --------------------------------------------------------------------- the app

class App:
    def __init__(self, host, compose_cmd):
        self.host = host
        self.compose = compose_cmd
        self.containers = []
        self.stats = {}
        self.loaded = False
        self.error = ""
        self.sel_id = None
        self.top = 0
        self.filter = ""
        self.show_all = True
        self.busy = {}
        self.msg, self.msg_err, self.msg_t = "", False, 0.0
        self.stop_ev = threading.Event()
        self.wake = threading.Event()
        self.scr = None
        self.draw_fn = self.draw_main
        self._home = None

    # ---- background polling
    def poll_containers(self):
        while not self.stop_ev.is_set():
            rc, out, err = self.host.run(LIST_SCRIPT, timeout=30)
            try:
                data = json.loads(out) if out.strip() else None
            except ValueError:
                data = None
            if data is None:
                self.error = ((err or out).strip().splitlines() or ["docker ps failed"])[-1]
            else:
                self.containers = sorted((parse_container(d) for d in data),
                                         key=lambda c: (c["project"].lower(), c["name"].lower()))
                self.error = ""
                self.loaded = True
            self.wake.wait(3)
            self.wake.clear()

    def poll_stats(self):
        while not self.stop_ev.is_set():
            if any(c["state"] == "running" for c in self.containers):
                rc, out, _ = self.host.run(["docker", "stats", "--no-stream", "--format", "{{json .}}"], timeout=30)
                if rc == 0:
                    self.stats = {s.get("ID", "")[:12]: s for s in json_lines(out)}
            self.stop_ev.wait(4)

    # ---- small helpers
    def flash(self, msg, err=False):
        self.msg, self.msg_err, self.msg_t = msg, err, time.time()

    def refresh_soon(self):
        self.wake.set()

    def home(self):
        if self._home is None:
            rc, out, _ = self.host.run('printf %s "$HOME"')
            self._home = out.strip() or "/root"
        return self._home

    def expand(self, path):
        return self.home() + path[1:] if path == "~" or path.startswith("~/") else path

    def bg(self, c, verb, cmd):
        """Run a quick docker command in the background, showing progress in the list."""
        name = c["name"]
        self.busy[c["id"]] = verb + "…"

        def work():
            rc, out, err = self.host.run(cmd, timeout=180)
            if rc == 0:
                self.flash("%s %s: done" % (verb, name))
            else:
                self.flash("%s %s failed: %s" % (verb, name, ((err or out).strip().splitlines() or ["?"])[-1]),
                           err=True)
            self.busy.pop(c["id"], None)
            self.refresh_soon()
        threading.Thread(target=work, daemon=True).start()

    def capture(self, cmd, timeout=60):
        """Run and return combined output, flashing an error on failure (None)."""
        rc, out, err = self.host.run(cmd, timeout=timeout)
        if rc != 0:
            self.flash(((err or out).strip().splitlines() or ["command failed (%d)" % rc])[-1], err=True)
            return None
        return out

    @contextmanager
    def suspended(self):
        """Leave curses temporarily to use the plain terminal."""
        curses.endwin()
        try:
            yield
        finally:
            self.scr.clear()
            self.scr.refresh()

    def run_term(self, cmd, wait=True, note=""):
        with self.suspended():
            print("\n\033[1m$ %s\033[0m%s\n" % (cmd if isinstance(cmd, str) else shlex.join(cmd),
                                                 "   (%s)" % note if note else ""))
            rc = self.host.interactive(cmd)
            if wait:
                print("\n%s" % ("done" if rc == 0 else "exit code %d" % rc))
                pause()
        self.refresh_soon()
        return rc

    def page(self, text, title="", end=False):
        with self.suspended():
            less = shutil.which("less")
            if not less:
                print(title + "\n" + text)
                pause()
                return
            prompt = re.sub(r"([?:.%\\])", r"\\\1", (title + "  " if title else "") + "(q to return, / to search)")
            env = dict(os.environ, LESS="-R", LESSSECURE="1")
            p = subprocess.Popen([less, "-Ps" + prompt] + (["+G"] if end else []),
                                 stdin=subprocess.PIPE, text=True, errors="replace", env=env)
            try:
                p.communicate(text)
            except (BrokenPipeError, KeyboardInterrupt):
                pass
            while True:
                try:
                    p.wait()
                    break
                except KeyboardInterrupt:
                    pass

    # ---- curses primitives
    def put(self, y, x, text, attr=0):
        h, w = self.scr.getmaxyx()
        if 0 <= y < h and 0 <= x < w:
            try:
                self.scr.addnstr(y, x, text, w - x, attr)
            except curses.error:
                pass

    def box(self, y, x, h, w):
        for i in range(h):
            self.put(y + i, x, " " * w)
        try:
            self.scr.hline(y, x + 1, curses.ACS_HLINE, w - 2)
            self.scr.hline(y + h - 1, x + 1, curses.ACS_HLINE, w - 2)
            self.scr.vline(y + 1, x, curses.ACS_VLINE, h - 2)
            self.scr.vline(y + 1, x + w - 1, curses.ACS_VLINE, h - 2)
            for yy, xx, ch in ((y, x, curses.ACS_ULCORNER), (y, x + w - 1, curses.ACS_URCORNER),
                               (y + h - 1, x, curses.ACS_LLCORNER), (y + h - 1, x + w - 1, curses.ACS_LRCORNER)):
                self.scr.addch(yy, xx, ch)
        except curses.error:
            pass

    def read_key(self):
        try:
            return self.scr.get_wch()
        except curses.error:
            return None

    def menu(self, title, items, note="", default=0):
        """Popup menu of (key, label) items (None = separator). Returns the chosen key or None."""
        choices = [i for i, it in enumerate(items) if it]
        pos = min(default, len(choices) - 1)
        while True:
            self.draw_fn()
            h, w = self.scr.getmaxyx()
            note_lines = [ln for para in note.splitlines() for ln in wrap(para, min(70, w - 6))] if note else []
            labels = ["" if it is None else " %s  %s " % (it[0], it[1]) for it in items]
            bw = min(w, max([len(title) + 4] + [len(s) + 4 for s in labels + note_lines]))
            bh = min(h, len(items) + len(note_lines) + (1 if note_lines else 0) + 4)
            y0, x0 = max(0, (h - bh) // 2), max(0, (w - bw) // 2)
            self.box(y0, x0, bh, bw)
            self.put(y0, x0 + 2, " %s " % trunc(title, bw - 6), curses.A_BOLD)
            y = y0 + 1
            for ln in note_lines:
                self.put(y, x0 + 2, ln, self.c_dim)
                y += 1
            if note_lines:
                y += 1
            for i, it in enumerate(items):
                if y >= y0 + bh - 1:
                    break
                if it is None:
                    try:
                        self.scr.hline(y, x0 + 1, curses.ACS_HLINE, bw - 2)
                    except curses.error:
                        pass
                else:
                    attr = curses.A_REVERSE if i == choices[pos] else 0
                    self.put(y, x0 + 2, labels[i].ljust(bw - 4), attr)
                y += 1
            self.put(y0 + bh - 1, x0 + 2, " Enter select · Esc cancel ", self.c_dim)
            k = self.read_key()
            if k is None or k == curses.KEY_RESIZE:
                continue
            if k in ("\x1b", "q") and not any(it and it[0] == "q" for it in items):
                return None
            if k == "\x1b":
                return None
            if k in (curses.KEY_UP, "k"):
                pos = (pos - 1) % len(choices)
            elif k in (curses.KEY_DOWN, "j"):
                pos = (pos + 1) % len(choices)
            elif k in ("\n", "\r", curses.KEY_ENTER):
                return items[choices[pos]][0]
            elif isinstance(k, str):
                for it in items:
                    if it and it[0] == k:
                        return k

    def confirm(self, question, note=""):
        return self.menu(question, [("y", "Yes"), ("n", "No")], note=note, default=1) == "y"

    def prompt(self, label, default=""):
        """Single-line input on the bottom row. Returns None on Esc."""
        buf = list(default)
        curses.curs_set(1)
        try:
            while True:
                self.draw_fn()
                h, w = self.scr.getmaxyx()
                text = label + " " + "".join(buf)
                shown = text[-(w - 1):]
                self.put(h - 1, 0, shown.ljust(w - 1), curses.A_BOLD)
                self.scr.move(h - 1, min(len(shown), w - 1))
                k = self.read_key()
                if k is None or k == curses.KEY_RESIZE:
                    continue
                if k in ("\n", "\r", curses.KEY_ENTER):
                    return "".join(buf).strip()
                if k == "\x1b":
                    return None
                if k in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                    if buf:
                        buf.pop()
                elif k == "\x15":  # Ctrl-U
                    buf = []
                elif isinstance(k, str) and k.isprintable():
                    buf.append(k)
        finally:
            curses.curs_set(0)

    def pick(self, title, header, rows, hint):
        """Full-screen list. Returns (key, index); key is "\\n" for Enter, None to go back."""
        pos, top = 0, 0
        prev = self.draw_fn

        def draw():
            nonlocal top
            self.scr.erase()
            h, w = self.scr.getmaxyx()
            self.put(0, 0, (" %s  —  %s" % (title, self.host.label)).ljust(w), curses.A_REVERSE | curses.A_BOLD)
            self.put(1, 0, " " + header, curses.A_BOLD)
            lh = max(1, h - 3)
            top = min(top, pos)
            if pos >= top + lh:
                top = pos - lh + 1
            for i, row in enumerate(rows[top:top + lh]):
                self.put(2 + i, 0, (" " + row).ljust(w), curses.A_REVERSE if top + i == pos else 0)
            if not rows:
                self.put(3, 2, "(nothing here)", self.c_dim)
            self.footer(hint)

        self.draw_fn = draw
        try:
            while True:
                draw()
                k = self.read_key()
                if k is None or k == curses.KEY_RESIZE:
                    continue
                lh = max(1, self.scr.getmaxyx()[0] - 3)
                if k in ("q", "\x1b", curses.KEY_LEFT):
                    return None, None
                if k in (curses.KEY_UP, "k"):
                    pos = max(0, pos - 1)
                elif k in (curses.KEY_DOWN, "j"):
                    pos = min(len(rows) - 1, pos + 1)
                elif k == curses.KEY_PPAGE:
                    pos = max(0, pos - lh)
                elif k == curses.KEY_NPAGE:
                    pos = max(0, min(len(rows) - 1, pos + lh))
                elif k in (curses.KEY_HOME, "g"):
                    pos = 0
                elif k in (curses.KEY_END, "G"):
                    pos = max(0, len(rows) - 1)
                elif k in ("\n", "\r", curses.KEY_ENTER):
                    if rows:
                        return "\n", pos
                elif isinstance(k, str):
                    return k, (pos if rows else None)
        finally:
            self.draw_fn = prev

    def footer(self, hint):
        h, w = self.scr.getmaxyx()
        if self.msg and time.time() - self.msg_t < 8:
            self.put(h - 1, 0, (" " + self.msg).ljust(w - 1), self.c_err if self.msg_err else self.c_ok)
        else:
            self.put(h - 1, 0, trunc(" " + hint, w - 1), self.c_dim)

    # ---- main screen
    def view(self):
        f = self.filter.lower()
        return [c for c in self.containers
                if (self.show_all or c["state"] in ("running", "restarting", "paused"))
                and (not f or f in ("%s %s %s" % (c["name"], c["image"], c["project"])).lower())]

    def selected(self, view=None):
        view = self.view() if view is None else view
        if not view:
            return None, 0
        for i, c in enumerate(view):
            if c["id"] == self.sel_id:
                return c, i
        self.sel_id = view[0]["id"]
        return view[0], 0

    def row_attr(self, c):
        if c["id"] in self.busy:
            return self.c_warn
        s = c["state"]
        if s == "running":
            return {"unhealthy": self.c_err, "starting": self.c_warn}.get(c["health"], self.c_ok)
        if s in ("restarting", "dead") or (s == "exited" and c["exit_code"] not in (0, 137, 143)):
            return self.c_err
        if s == "paused":
            return self.c_warn
        return self.c_dim

    def draw_main(self):
        s = self.scr
        s.erase()
        h, w = s.getmaxyx()
        if h < 8 or w < 40:
            self.put(0, 0, "Terminal too small")
            return
        view = self.view()
        cur, idx = self.selected(view)
        running = sum(c["state"] == "running" for c in self.containers)
        title = " dockman  %s   %d/%d running" % (self.host.label, running, len(self.containers))
        if not self.show_all:
            title += "   [running only]"
        if self.filter:
            title += "   filter: " + self.filter
        self.put(0, 0, title.ljust(w), curses.A_REVERSE | curses.A_BOLD)
        clock = time.strftime(" %H:%M:%S ")
        self.put(0, w - len(clock), clock, curses.A_REVERSE)

        nw = min(max([len(c["name"]) for c in view] + [4]), 32)
        pw = min(max([len(c["project"]) for c in view] + [7]), 18)
        cols = [("NAME", nw), ("STATUS", 24), ("CPU", 7), ("MEM", 9), ("RESTART", 14),
                ("PROJECT", pw), ("IMAGE", 32), ("PORTS", 0)]

        def fmt(vals):
            return " " + " ".join(trunc(v, cw).ljust(cw) if cw else v for v, (_, cw) in zip(vals, cols))

        self.put(1, 0, fmt([n for n, _ in cols]), curses.A_BOLD | curses.A_UNDERLINE)
        lh = h - 5
        if idx < self.top:
            self.top = idx
        elif idx >= self.top + lh:
            self.top = idx - lh + 1
        self.top = max(0, min(self.top, max(0, len(view) - lh)))
        for i, c in enumerate(view[self.top:self.top + lh]):
            st = self.stats.get(c["id"], {}) if c["state"] == "running" else {}
            line = fmt([c["name"], self.busy.get(c["id"], c["status"]), st.get("CPUPerc", ""),
                        st.get("MemUsage", "").split(" / ")[0], c["restart"], c["project"], c["image"],
                        ", ".join(c["ports"])])
            attr = self.row_attr(c) | (curses.A_REVERSE if self.top + i == idx else 0)
            self.put(2 + i, 0, line.ljust(w), attr)

        if self.error:
            self.put(3, 2, "Error: " + self.error, self.c_err)
        elif not self.loaded:
            self.put(3, 2, "Loading…", self.c_dim)
        elif not view:
            self.put(3, 2, "No containers%s.  Press a to add one." % (" match" if self.filter else ""), self.c_dim)

        if cur:
            d1 = " %s  %s  restarts: %s" % (cur["id"], cur["image"], cur["restart_count"])
            if cur["ports"]:
                d1 += "  ports: " + ", ".join(cur["ports"])
            if cur["project"]:
                d2 = " compose: %s/%s  %s" % (cur["project"], cur["service"], cur["wd"])
            else:
                st = self.stats.get(cur["id"], {})
                d2 = " net I/O %s   block I/O %s   pids %s" % (st.get("NetIO", "-"), st.get("BlockIO", "-"),
                                                             st.get("PIDs", "-")) if st else ""
            self.put(h - 3, 0, d1, self.c_dim)
            self.put(h - 2, 0, d2, self.c_dim)
        self.footer(HINTS)

    def run(self, stdscr):
        self.scr = stdscr
        curses.curs_set(0)
        curses.use_default_colors()
        for n, col in ((1, curses.COLOR_GREEN), (2, curses.COLOR_YELLOW), (3, curses.COLOR_RED)):
            curses.init_pair(n, col, -1)
        self.c_ok, self.c_warn, self.c_err = (curses.color_pair(n) for n in (1, 2, 3))
        self.c_dim = curses.A_DIM
        stdscr.keypad(True)
        stdscr.timeout(300)
        for fn in (self.poll_containers, self.poll_stats):
            threading.Thread(target=fn, daemon=True).start()
        self.keymap = {k: (lbl, getattr(self, "a_" + fn), True) for k, lbl, fn in filter(None, CONTAINER_ACTIONS)}
        self.keymap.update({k: (lbl, getattr(self, "g_" + fn), False) for k, lbl, fn in GLOBAL_ACTIONS})
        try:
            while True:
                self.draw_main()
                k = self.read_key()
                if k is None or k == curses.KEY_RESIZE:
                    continue
                if self.on_key(k) is False:
                    break
        except KeyboardInterrupt:
            pass
        finally:
            self.stop_ev.set()

    def on_key(self, k):
        view = self.view()
        cur, idx = self.selected(view)
        lh = max(1, self.scr.getmaxyx()[0] - 5)
        moves = {curses.KEY_UP: -1, "k": -1, curses.KEY_DOWN: 1, "j": 1,
                 curses.KEY_PPAGE: -lh, curses.KEY_NPAGE: lh, curses.KEY_HOME: -10 ** 6, "g": -10 ** 6,
                 curses.KEY_END: 10 ** 6, "G": 10 ** 6}
        if k in moves:
            if view:
                self.sel_id = view[max(0, min(len(view) - 1, idx + moves[k]))]["id"]
            return True
        if k in ("\n", "\r", curses.KEY_ENTER):
            if not cur:
                return True
            items = [None if a is None else a[:2] for a in CONTAINER_ACTIONS]
            k = self.menu("%s  (%s)" % (cur["name"], cur["state"]), items)
            if k is None:
                return True
        if k not in self.keymap:
            return True
        _, fn, needs = self.keymap[k]
        if needs:
            if not cur:
                self.flash("No container selected", err=True)
                return True
            return fn(cur)
        return fn()

    # ------------------------------------------------------- container actions
    def a_start(self, c):
        if c["state"] == "paused":
            self.bg(c, "unpause", ["docker", "unpause", c["name"]])
        elif c["state"] == "running":
            self.flash("%s is already running" % c["name"])
        else:
            self.bg(c, "start", ["docker", "start", c["name"]])

    def a_stop(self, c):
        if c["state"] not in ("running", "restarting", "paused"):
            return self.flash("%s is not running" % c["name"])
        note = {
            "always": "Restart policy is 'always': Docker leaves it stopped now, but starts it again "
                      "when the Docker daemon or server restarts. Use X to stop it for good.",
            "unless-stopped": "Restart policy is 'unless-stopped': it stays stopped, even across reboots, "
                              "until you start it.",
        }.get(c["restart"], "")
        if self.confirm("Stop %s?" % c["name"], note):
            self.bg(c, "stop", ["docker", "stop", c["name"]])

    def a_stop_hard(self, c):
        note = "Sets the restart policy to 'no' and stops it, so nothing brings it back automatically."
        if c["project"]:
            note += "\nNote: compose re-applies its own policy on the next 'up' of project %s." % c["project"]
        if not self.confirm("Disable auto-restart and stop %s?" % c["name"], note):
            return
        script = "docker update --restart=no %s >/dev/null" % q(c["name"])
        if c["state"] in ("running", "restarting", "paused"):
            script += " && docker stop %s" % q(c["name"])
        self.bg(c, "stop (no restart)", script)

    def a_restart(self, c):
        if self.confirm("Restart %s?" % c["name"]):
            self.bg(c, "restart", ["docker", "restart", c["name"]])

    def a_pause(self, c):
        if c["state"] == "paused":
            self.bg(c, "unpause", ["docker", "unpause", c["name"]])
        elif c["state"] == "running":
            self.bg(c, "pause", ["docker", "pause", c["name"]])
        else:
            self.flash("%s is not running" % c["name"], err=True)

    def a_kill(self, c):
        if c["state"] not in ("running", "restarting", "paused"):
            return self.flash("%s is not running" % c["name"])
        if self.confirm("Kill %s (SIGKILL, no clean shutdown)?" % c["name"]):
            self.bg(c, "kill", ["docker", "kill", c["name"]])

    def a_remove(self, c):
        note = ""
        if c["state"] in ("running", "restarting", "paused"):
            note = "It is running and will be force-stopped first. "
        if c["project"]:
            note += "It belongs to compose project '%s' and will be re-created on the next 'up'." % c["project"]
        k = self.menu("Remove %s?" % c["name"], [("r", "Remove container"),
                                                 ("v", "Remove container and its anonymous volumes"),
                                                 ("n", "Cancel")], note=note, default=2)
        if k in ("r", "v") and self.confirm("Really remove %s?" % c["name"]):
            self.bg(c, "remove", ["docker", "rm", "-f"] + (["-v"] if k == "v" else []) + [c["name"]])

    def a_logs(self, c, args=("--tail", "5000"), grep=None):
        out = self.capture(shlex.join(["docker", "logs", "-t"] + list(args) + [c["name"]]) + " 2>&1", timeout=120)
        if out is None:
            return
        if grep:
            try:
                rx = re.compile(grep, re.I)
            except re.error:
                rx = re.compile(re.escape(grep), re.I)
            out = "\n".join(ln for ln in out.splitlines() if rx.search(ln))
        self.page(out or "(no log output)", "logs %s" % c["name"], end=True)

    def a_logs_opts(self, c):
        since = self.prompt("Since (e.g. 30m, 6h, 2026-10-24T09:00; blank = beginning):")
        if since is None:
            return
        tail = self.prompt("Last N lines only (blank = all):")
        if tail is None:
            return
        grep = self.prompt("Only lines matching (text or regex, blank = all):")
        if grep is None:
            return
        args = (["--since", since] if since else []) + (["--tail", tail] if tail else [])
        self.a_logs(c, args, grep)

    def a_follow(self, c):
        self.run_term(["docker", "logs", "-f", "-t", "--tail", "200", c["name"]], wait=False,
                      note="Ctrl-C to return")

    def a_shell(self, c):
        if c["state"] != "running":
            return self.flash("%s is not running" % c["name"], err=True)
        with self.suspended():
            print("\n\033[1mShell in %s\033[0m (exit or Ctrl-D to return)\n" % c["name"])
            rc = self.host.interactive(["docker", "exec", "-it", c["name"], "sh", "-c", SHELL_PICKER])
            if rc in (125, 126, 127):
                print("\nCould not start a shell (the image may not contain one).")
                pause()

    def a_exec_cmd(self, c):
        if c["state"] != "running":
            return self.flash("%s is not running" % c["name"], err=True)
        cmd = self.prompt("Command to run in %s:" % c["name"])
        if cmd:
            self.run_term(["docker", "exec", "-it", c["name"], "sh", "-c", cmd])

    def a_info(self, c):
        d = c["raw"]
        st, cfg, hc = d.get("State") or {}, d.get("Config") or {}, d.get("HostConfig") or {}
        L = ["Name:        %s" % c["name"],
             "ID:          %s" % d.get("Id", ""),
             "Image:       %s  (%s)" % (c["image"], c["image_id"][:19]),
             "Created:     %s" % d.get("Created", "")[:19].replace("T", " "),
             "State:       %s   %s" % (c["state"], c["status"]),
             "Started:     %s" % st.get("StartedAt", "")[:19].replace("T", " "),
             "Finished:    %s" % (st.get("FinishedAt", "")[:19].replace("T", " ") if c["state"] != "running" else "-"),
             "Exit code:   %s%s" % (st.get("ExitCode"), "  (OOM killed)" if st.get("OOMKilled") else ""),
             "Restart:     policy=%s   restart count=%s" % (c["restart"], c["restart_count"])]
        if st.get("Error"):
            L.append("Error:       %s" % st["Error"])
        if c["project"]:
            L += ["Compose:     project=%s service=%s" % (c["project"], c["service"]),
                  "             dir=%s" % c["wd"], "             files=%s" % ", ".join(c["files"])]
        L += ["Entrypoint:  %s" % shlex.join(cfg.get("Entrypoint") or []),
              "Command:     %s" % shlex.join(cfg.get("Cmd") or []),
              "Working dir: %s" % (cfg.get("WorkingDir") or "/"),
              "User:        %s" % (cfg.get("User") or "(image default)"),
              "", "Ports:"]
        L += ["  " + p for p in c["ports"]] or ["  (none published)"]
        L += ["", "Mounts:"]
        L += ["  %-6s %s -> %s%s" % (m.get("Type"), m.get("Name") or m.get("Source"), m.get("Destination"),
                                     "" if m.get("RW", True) else " (ro)") for m in d.get("Mounts") or []] or ["  (none)"]
        L += ["", "Networks:"]
        for n, v in ((d.get("NetworkSettings") or {}).get("Networks") or {}).items():
            L.append("  %-20s ip=%s  gateway=%s" % (n, v.get("IPAddress") or "-", v.get("Gateway") or "-"))
        lim = []
        if hc.get("Memory"):
            lim.append("memory=%dMiB" % (hc["Memory"] // 1048576))
        if hc.get("NanoCpus"):
            lim.append("cpus=%g" % (hc["NanoCpus"] / 1e9))
        L += ["", "Limits:      %s" % (" ".join(lim) or "none")]
        L += ["", "Environment:"] + ["  " + e for e in cfg.get("Env") or []]
        labels = {k: v for k, v in (cfg.get("Labels") or {}).items() if not k.startswith("com.docker.compose.")}
        if labels:
            L += ["", "Labels:"] + ["  %s=%s" % kv for kv in sorted(labels.items())]
        hl = (st.get("Health") or {}).get("Log") or []
        if hl:
            L += ["", "Health checks (latest last):"]
            for e in hl[-5:]:
                L.append("  %s exit=%s  %s" % (e.get("Start", "")[:19].replace("T", " "), e.get("ExitCode"),
                                               (e.get("Output") or "").strip().replace("\n", " ")[:200]))
        self.page("\n".join(L) + "\n", "info %s" % c["name"])

    def a_inspect(self, c):
        self.page(json.dumps(c["raw"], indent=2), "inspect %s" % c["name"])

    def a_top(self, c):
        if c["state"] != "running":
            return self.flash("%s is not running" % c["name"], err=True)
        out = self.capture(["docker", "top", c["name"]])
        if out is not None:
            self.page(out, "processes in %s" % c["name"])

    def a_live_stats(self, c):
        self.run_term(["docker", "stats", c["name"]], wait=False, note="Ctrl-C to return")

    def a_policy(self, c):
        k = self.menu("Restart policy for %s (now: %s)" % (c["name"], c["restart"]),
                      [("u", "unless-stopped  (restart unless you stopped it)"),
                       ("a", "always          (restart, even after a manual stop + reboot)"),
                       ("f", "on-failure      (restart only on non-zero exit)"),
                       ("n", "no              (never restart automatically)")],
                      note="Compose re-applies its own value on the next 'up'." if c["project"] else "")
        if not k:
            return
        pol = {"u": "unless-stopped", "a": "always", "f": "on-failure", "n": "no"}[k]
        if k == "f":
            n = self.prompt("Max retries (blank = unlimited):")
            if n is None:
                return
            if n.isdigit():
                pol += ":" + n
        self.bg(c, "set restart=%s" % pol, ["docker", "update", "--restart", pol, c["name"]])

    def a_rename(self, c):
        new = self.prompt("New name for %s:" % c["name"], c["name"])
        if new and new != c["name"]:
            self.bg(c, "rename", ["docker", "rename", c["name"], new])

    def container_spec(self, c):
        rc, out, _ = self.host.run(["docker", "image", "inspect", "--format", "{{json .Config}}", c["image_id"]])
        try:
            img_cfg = json.loads(out) if rc == 0 else {}
        except ValueError:
            img_cfg = {}
        return spec_from_inspect(c["raw"], img_cfg or {})

    def a_export(self, c):
        sp = self.container_spec(c)
        text = ("# Best-effort reconstruction of %s. Covers name, image, restart policy, ports,\n"
                "# volumes/binds, environment (minus image defaults), network, devices,\n"
                "# capabilities and command. Check it before relying on it.\n\n"
                "# --- docker run ---\n%s\n\n# --- compose.yaml ---\n%s") % (c["name"], spec_run_text(sp), spec_compose(sp))
        self.page(text, "export %s" % c["name"])

    def a_update(self, c):
        if not c["project"]:
            return self.flash("Only compose containers can be recreated safely; use E to export it to compose.",
                              err=True)
        p = self.project_from(c)
        if self.confirm("Pull the latest image for %s/%s and recreate it?" % (c["project"], c["service"])):
            svc = [c["service"]] if c["service"] else []
            self.run_term(shlex.join(self.compose_cmd(p, "pull", *svc)) + " && " +
                          shlex.join(self.compose_cmd(p, "up", "-d", *svc)))

    def a_compose_sel(self, c):
        if not c["project"]:
            return self.flash("%s is not part of a compose project" % c["name"], err=True)
        self.compose_menu(self.project_from(c))

    # ---------------------------------------------------------------- compose
    def project_from(self, c):
        return {"name": c["project"], "wd": c["wd"], "files": c["files"]}

    def compose_cmd(self, p, *args):
        cmd = list(self.compose) + ["-p", p["name"]]
        if p.get("wd"):
            cmd += ["--project-directory", p["wd"]]
        for f in p.get("files") or []:
            cmd += ["-f", f]
        return cmd + list(args)

    def list_projects(self):
        projects = {}
        rc, out, _ = self.host.run(list(self.compose) + ["ls", "-a", "--format", "json"])
        try:
            for r in json.loads(out) if rc == 0 and out.strip() else []:
                files = [f for f in (r.get("ConfigFiles") or "").split(",") if f]
                projects[r["Name"]] = {"name": r["Name"], "status": r.get("Status", ""), "files": files,
                                       "wd": os.path.dirname(files[0]) if files else ""}
        except (ValueError, KeyError, TypeError):
            pass
        for c in self.containers:  # also covers docker-compose v1, which has no `ls`
            if c["project"]:
                p = projects.setdefault(c["project"], {"name": c["project"], "status": "", "files": c["files"],
                                                       "wd": c["wd"]})
                p["wd"] = c["wd"] or p["wd"]
        for p in projects.values():
            if not p["status"]:
                cs = [c for c in self.containers if c["project"] == p["name"]]
                p["status"] = "running(%d) / total(%d)" % (sum(c["state"] == "running" for c in cs), len(cs))
        return sorted(projects.values(), key=lambda p: p["name"])

    def g_projects(self):
        while True:
            projects = self.list_projects()
            rows = ["%-28s %-26s %s" % (trunc(p["name"], 28), trunc(p["status"], 26), ", ".join(p["files"]))
                    for p in projects]
            k, i = self.pick("Compose projects", "%-28s %-26s %s" % ("NAME", "STATUS", "COMPOSE FILES"), rows,
                             "Enter actions  a new project  o start existing compose file  q back")
            if k is None:
                return
            if k == "a":
                self.compose_new()
            elif k == "o":
                self.compose_existing()
            elif k == "\n" and i is not None:
                self.compose_menu(projects[i])

    def compose_menu(self, p):
        p = dict(p)
        if p.get("files"):
            rc, _, _ = self.host.run(" && ".join("test -f %s" % q(f) for f in p["files"]))
            if rc != 0:
                self.flash("Compose file(s) for %s no longer exist; only stop/start/down will work." % p["name"],
                           err=True)
                p["files"], p["wd"] = [], ""
        items = [("u", "Up (create/apply changes, detached)"),
                 ("U", "Pull newer images and up (update)"),
                 ("s", "Start"), ("x", "Stop"), ("r", "Restart"),
                 ("d", "Down (remove containers & networks)"),
                 ("D", "Down and delete its volumes"),
                 None,
                 ("l", "Follow logs"), ("p", "Status (ps)"),
                 ("c", "Show resolved config"),
                 ("e", "Edit compose file"),
                 ("b", "Back")]
        while True:
            k = self.menu("Compose: %s" % p["name"], items, note=p.get("wd") or "")
            if k in (None, "b"):
                return
            if k == "u":
                self.run_term(self.compose_cmd(p, "up", "-d", "--remove-orphans"))
            elif k == "U":
                self.run_term(shlex.join(self.compose_cmd(p, "pull")) + " && " +
                              shlex.join(self.compose_cmd(p, "up", "-d", "--remove-orphans")))
            elif k in ("s", "x", "r"):
                self.run_term(self.compose_cmd(p, {"s": "start", "x": "stop", "r": "restart"}[k]))
            elif k == "d" and self.confirm("Bring %s down (containers removed, volumes kept)?" % p["name"]):
                self.run_term(self.compose_cmd(p, "down"))
            elif k == "D" and self.confirm("Bring %s down AND DELETE its volumes (data loss)?" % p["name"]):
                self.run_term(self.compose_cmd(p, "down", "-v"))
            elif k == "l":
                self.run_term(self.compose_cmd(p, "logs", "-f", "-t", "--tail", "100"), wait=False,
                              note="Ctrl-C to return")
            elif k == "p":
                out = self.capture(self.compose_cmd(p, "ps", "-a"))
                if out is not None:
                    self.page(out, "compose ps %s" % p["name"])
            elif k == "c":
                out = self.capture(self.compose_cmd(p, "config"))
                if out is not None:
                    self.page(out, "compose config %s" % p["name"])
            elif k == "e":
                self.compose_edit(p)

    def compose_edit(self, p):
        files = p.get("files") or []
        if not files:
            return self.flash("No compose file known for %s" % p["name"], err=True)
        path = files[0]
        if len(files) > 1:
            k = self.menu("Which file?", [(str(i + 1), f) for i, f in enumerate(files[:9])])
            if not k:
                return
            path = files[int(k) - 1]
        rc, text, err = self.host.run(["cat", "--", path])
        if rc != 0:
            return self.flash("Cannot read %s: %s" % (path, err.strip()), err=True)
        with self.suspended():
            try:
                new = edit_text(text)
                if new is None:
                    print("No editor found: set $EDITOR (or install nano/vim).")
                    return pause()
                if new == text:
                    print("No changes.")
                    return
                self.host.run(["cp", "-p", "--", path, path + ".bak"])
                while True:
                    rc, out, err = self.host.write_file(path, new)
                    if rc != 0:
                        print("Write failed: " + err)
                        return pause()
                    rc, out, err = self.host.run(self.compose_cmd(p, "config", "-q"))
                    if rc == 0:
                        print("Saved %s (previous version kept as %s.bak)." % (path, os.path.basename(path)))
                        break
                    print("\n\033[31mThe compose file does not validate:\033[0m\n" + (err or out))
                    choice = ask("[e]dit again, [r]estore previous version, [k]eep anyway", "e").lower()
                    if choice.startswith("r"):
                        self.host.run(["cp", "-p", "--", path + ".bak", path])
                        print("Restored.")
                        return pause()
                    if choice.startswith("k"):
                        return pause()
                    new = edit_text(new)
                if ask_yn("Apply the changes now (docker compose up -d)?"):
                    self.host.interactive(self.compose_cmd(p, "up", "-d", "--remove-orphans"))
                    pause()
            except Cancel:
                print("Cancelled.")
        self.refresh_soon()

    def compose_new(self, yaml_text=None, name=""):
        with self.suspended():
            try:
                self._compose_new(yaml_text, name)
            except Cancel:
                print("Cancelled.")
                pause()
        self.refresh_soon()

    def _compose_new(self, yaml_text, name):
        print("\n\033[1mNew compose project on %s\033[0m  (Ctrl-C cancels)\n" % self.host.label)
        name = slug(ask("Project name", slug(name) if name else "", required=True))
        root = os.environ.get("DOCKMAN_COMPOSE_ROOT") or self.home() + "/docker"
        d = self.expand(ask("Directory on the server", "%s/%s" % (root.rstrip("/"), name))).rstrip("/")
        rc, existing, _ = self.host.run("cd %s 2>/dev/null && ls %s 2>/dev/null" % (q(d), " ".join(COMPOSE_NAMES)))
        if existing.strip():
            print("%s already contains: %s" % (d, existing.split()))
            if not ask_yn("Overwrite %s/compose.yaml?" % d, False):
                raise Cancel()
        path = d + "/compose.yaml"
        p = {"name": name, "wd": d, "files": [path]}

        if yaml_text is None:
            how = ask("Write it in your [e]ditor from a template, or [p]aste it", "e").lower()
            if how.startswith("p"):
                yaml_text = read_pasted("Paste the compose YAML:")
            else:
                yaml_text = edit_text(COMPOSE_TEMPLATE.format(name=name))
                if yaml_text is None:
                    yaml_text = read_pasted("No editor found ($EDITOR). Paste the compose YAML instead:")
        else:
            print("\n" + yaml_text)
            if ask_yn("Review/edit it in your editor first?", False):
                yaml_text = edit_text(yaml_text) or yaml_text

        while True:
            rc, _, err = self.host.write_file(path, yaml_text)
            if rc != 0:
                print("Could not write %s: %s" % (path, err))
                return pause()
            rc, out, err = self.host.run(self.compose_cmd(p, "config", "-q"))
            if rc == 0:
                print("Wrote %s" % path)
                break
            print("\n\033[31mThe compose file does not validate:\033[0m\n" + (err or out))
            if not ask("[e]dit again or [k]eep it as is (it won't be started)", "e").lower().startswith("e"):
                return pause()
            yaml_text = edit_text(yaml_text) or read_pasted("Paste the corrected YAML:")

        if ask_yn("Start it now (docker compose up -d)?"):
            self.host.interactive(self.compose_cmd(p, "up", "-d"))
        pause()

    def compose_existing(self):
        with self.suspended():
