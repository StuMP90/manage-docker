    def disk_summary(self):
        out = self.capture(["docker", "system", "df", "--format", "{{json .}}"], timeout=120)
        if out is None:
            return None
        L = ["%-14s %7s %7s %10s  %s" % ("TYPE", "TOTAL", "ACTIVE", "SIZE", "RECLAIMABLE")]
        for r in json_lines(out):
            L.append("%-14s %7s %7s %10s  %s" % (r.get("Type", ""), r.get("TotalCount", ""), r.get("Active", ""),
                                                   r.get("Size", ""), r.get("Reclaimable", "")))
        rc, fs, _ = self.host.run('df -h "$(docker info --format "{{.DockerRootDir}}")" | tail -n 1')
        if rc == 0 and fs.strip():
            p = fs.split()
            if len(p) >= 6:
                L += ["", "Filesystem %s: %s used of %s (%s), %s free" % (p[5], p[2], p[1], p[4], p[3])]
        return "\n".join(L)

    def disk_images_table(self):
        """The Images part of `docker system df -v`, with both build and pull dates."""
        rc, out, _ = self.host.run(["docker", "system", "df", "-v", "--format", "json"], timeout=120)
        try:
            imgs = json.loads(out)["Images"] or [] if rc == 0 else None
        except (ValueError, KeyError, TypeError):
            imgs = None
        if imgs is None:
            return ""
        dates = self.image_dates(im["ID"] for im in imgs)
        fmt = "%-40s %-12s %-9s %-9s %-9s %-11s %s"
        L = ["Images space usage:", "", fmt % ("IMAGE", "ID", "BUILT", "PULLED", "SIZE", "UNIQUE SIZE", "CONTAINERS")]
        for im in imgs:
            ref = im["ID"][7:19] if im.get("Repository") == "<none>" else "%s:%s" % (im["Repository"], im["Tag"])
            built, pulled = dates.get(im["ID"], (None, None))
            L.append(fmt % (trunc(ref, 40), im["ID"][7:19], ago(built) if built else "-",
                            ago(pulled) if pulled else "-", im.get("Size", ""), im.get("UniqueSize", ""),
                            im.get("Containers", "")))
        return "\n".join(L) + "\n\n"

    def g_disk(self):
        while True:
            summary = self.disk_summary()
            if summary is None:
                return
            k = self.menu("Disk usage on %s" % self.host.label,
                          [("d", "Detailed breakdown (per image / container / volume)"),
                           ("o", "Prune images older than…"),
                           ("x", "Other prune options…"),
                           ("b", "Back")], note=summary)
            if k in (None, "b"):
                return
            if k == "d":
                out = self.capture(["docker", "system", "df", "-v"], timeout=120)
                if out is not None:
                    self.page(self.disk_images_table() + out[max(out.find("Containers space usage:"), 0):],
                              "disk usage")
            elif k == "o":
                self.prune_old_images()
            elif k == "x":
                self.prune_menu()

    def prune_old_images(self):
        age = self.prompt("Remove unused images older than (e.g. 30d, 12h):", "30d")
        if not age:
            return
        m = re.fullmatch(r"(\d+)\s*([dhm]?)", age.lower())
        if not m:
            return self.flash("Use a number followed by d, h or m, e.g. 30d", err=True)
        hours = int(m.group(1)) * {"d": 24, "h": 1, "m": 1 / 60, "": 24}[m.group(2)]
        by = self.menu("Measure age from",
                       [("p", "Pull date: when it was pulled or tagged on this machine"),
                        ("b", "Build date: when the image was built (CREATED in docker images)")],
                       note="Untagged images with no pull date use their build date.", default=0)
        if not by:
            return
        verb = "pulled" if by == "p" else "built"
        k = self.menu("Prune images %s more than %s ago" % (verb, age),
                      [("a", "All unused images (tagged or not)"),
                       ("u", "Only untagged (dangling) images"),
                       ("n", "Cancel")],
                      note="Images used by any container (even a stopped one) are always kept.", default=0)
        if k not in ("a", "u"):
            return
        # Not `docker image prune --filter until=`: what it compares depends on the image
        # store (pull time with containerd, build time with the classic store).
        rc, out, err = self.host.run(["docker", "image", "ls", "-a", "--no-trunc", "--format", "{{json .}}"])
        if rc != 0:
            return self.flash(err.strip() or "docker image ls failed", err=True)
        sizes = {}
        for im in json_lines(out):
            sizes.setdefault(im.get("ID", ""), im.get("Size", "?"))
        if not sizes:
            return self.flash("No images.")
        rc, out, err = self.host.run(["docker", "image", "inspect"] + list(sizes))
        if rc != 0:
            return self.flash(err.strip() or "docker image inspect failed", err=True)
        images = json.loads(out or "[]")
        used = set()
        rc, cids, _ = self.host.run(["docker", "ps", "-aq", "--no-trunc"])
        if cids.split():
            rc, out, err = self.host.run(["docker", "inspect", "--format", "{{.Image}}"] + cids.split())
            if rc != 0:
                return self.flash(err.strip() or "docker inspect failed", err=True)
            used = set(out.split())
        cutoff = datetime.now(timezone.utc).timestamp() - hours * 3600
        doomed = []
        for im in images:
            built = parse_ts(im.get("Created", ""))
            pulled = parse_ts((im.get("Metadata") or {}).get("LastTagTime", ""))
            when = (pulled or built) if by == "p" else built
            tags = [t for t in im.get("RepoTags") or [] if not t.endswith(":<none>")]
            if im["Id"] in used or not when or when.timestamp() > cutoff or (k == "u" and tags):
                continue
            doomed.append((when, im["Id"], tags, built, pulled))
        if not doomed:
            return self.flash("No unused images %s more than %s ago." % (verb, age))
        doomed.sort(key=lambda d: d[0])
        fmt = "%-9s %-9s %-10s %-8s %s"
        lines = ["Measured by %s date." % ("pull" if by == "p" else "build"), "",
                 fmt % ("BUILT", "PULLED", "SIZE", "ID", "TAGS")]
        lines += [fmt % (ago(b) if b else "-", ago(p) if p else "-", sizes.get(i, "?"), i.split(":")[-1][:8],
                         ", ".join(t) or "<untagged>") for _, i, t, b, p in doomed]
        self.page("\n".join(lines) + "\n", title="images to remove")
        if self.confirm("Remove these %d image%s?" % (len(doomed), "s"[len(doomed) == 1:])):
            refs = [r for _, i, t, _, _ in doomed for r in (t or [i])]
            self.run_term(["docker", "rmi"] + refs)

    def prune_menu(self):
        options = {
            "c": ("stopped containers", ["docker", "container", "prune", "-f"]),
            "i": ("dangling (untagged) images", ["docker", "image", "prune", "-f"]),
            "I": ("ALL images not used by a container", ["docker", "image", "prune", "-a", "-f"]),
            "v": ("unused anonymous volumes", ["docker", "volume", "prune", "-f"]),
            "V": ("ALL unused volumes, named ones too (data loss!)", ["docker", "volume", "prune", "-a", "-f"]),
            "n": ("unused networks", ["docker", "network", "prune", "-f"]),
            "b": ("build cache", ["docker", "builder", "prune", "-f"]),
            "s": ("system: stopped containers, unused networks, dangling images, build cache",
                  ["docker", "system", "prune", "-f"]),
        }
        items = [(key, "Remove " + lbl) for key, (lbl, _) in options.items()]
        items.insert(3, ("o", "Remove unused images older than…"))
        k = self.menu("Prune", items)
        if k == "o":
            self.prune_old_images()
        elif k and self.confirm("Remove %s?" % options[k][0]):
            self.run_term(options[k][1])

    # ------------------------------------------------------------ misc globals
    def g_filter(self):
        f = self.prompt("Filter (name/image/project, blank clears):", self.filter)
        if f is not None:
            self.filter = f

    def g_toggle_all(self):
        self.show_all = not self.show_all

    def g_refresh(self):
        self.refresh_soon()
        self.flash("Refreshing…")

    def g_quit(self):
        return False

    def g_help(self):
        def fmt(k, lbl):
            return "  %-8s %s" % (k, lbl)
        L = ["dockman %s — managing Docker on %s" % (VERSION, self.host.label), "",
             "Moving:  Up/Down or j/k, PgUp/PgDn, Home/End or g/G.  Enter opens the action menu.", "",
             "Container keys:"]
        L += [fmt(a[0], a[1]) for a in CONTAINER_ACTIONS if a]
        L += ["", "Everywhere:"] + [fmt(a[0], a[1]) for a in GLOBAL_ACTIONS]
        L += ["", "Colours: green running, yellow paused/starting/busy, red unhealthy/restarting/failed,",
              "dim stopped cleanly.", "",
              "Restart policies and stopping:",
              "  A manual 'docker stop' is never undone by the restart policy while the daemon keeps running.",
              "  'always' containers do come back when the Docker daemon or the server restarts;",
              "  'unless-stopped' ones stay stopped. X sets the policy to 'no' and stops, so the",
              "  container stays down whatever happens. A container stuck in a restart loop is",
              "  stopped with x too.", "",
              "Disk space: D (or m → Disk usage) shows what Docker is using and offers pruning,",
              "including removing images older than a chosen age that no container uses."]
        self.page("\n".join(L) + "\n", "help")


def wrap(text, width):
    words, lines, cur = text.split(), [], ""
    for w in words:
        if cur and len(cur) + 1 + len(w) > width:
            lines.append(cur)
            cur = w
        else:
            cur = (cur + " " + w).strip()
    return lines + ([cur] if cur else [])


def main():
    ap = argparse.ArgumentParser(description="Interactive manager for the Docker containers on this machine.")
    ap.add_argument("--version", action="version", version="dockman " + VERSION)
    ap.parse_args()

    if not sys.stdin.isatty() or not sys.stdout.isatty():
        sys.exit("dockman needs an interactive terminal.")
    if not shutil.which("docker"):
        sys.exit("The docker command was not found on this machine.")

    host = Host()
    rc, out, err = host.run(["docker", "version", "--format", "{{.Server.Version}}"])
    if rc != 0:
        msg = (err or out).strip()
        hint = ""
        if "permission denied" in msg.lower():
            hint = "\nHint: add the user to the 'docker' group (sudo usermod -aG docker $USER) and log in again."
        sys.exit("Cannot talk to Docker:\n%s%s" % (msg, hint))
    compose = ["docker", "compose"]
    if host.run(compose + ["version"])[0] != 0 and host.run(["docker-compose", "version"])[0] == 0:
        compose = ["docker-compose"]

    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    curses.wrapper(App(host, compose).run)


if __name__ == "__main__":
    main()
