    def _run_wizard(self, sp):
        while True:
            print("\n\033[1mNew container on %s\033[0m  (Ctrl-C cancels; Enter keeps the [default])\n"
                  % self.host.label)
            sp["image"] = ask("Image (e.g. nginx:alpine, ghcr.io/org/app:1.2)", sp.get("image", ""), required=True)
            sp["name"] = ask("Container name", sp.get("name") or slug(sp["image"].split("/")[-1].split(":")[0]))
            sp["ports"] = ask("Publish ports host:container, space separated (e.g. 8080:80 127.0.0.1:5432:5432)",
                              " ".join(sp.get("ports", []))).replace(",", " ").split()
            sp["volumes"] = ask_list("Volumes / bind mounts  (named_volume:/path, /host/path:/path[:ro])",
                                     sp.get("volumes", []))
            sp["env"] = ask_list("Environment variables  (KEY=value)", sp.get("env", []))
            pol = {"u": "unless-stopped", "a": "always", "o": "on-failure", "n": "no"}
            cur = next((k for k, v in pol.items() if v == sp.get("restart")), "u")
            sp["restart"] = pol.get(ask("Restart policy: [u]nless-stopped, [a]lways, [o]n-failure, [n]o",
                                        cur).lower()[:1], "unless-stopped")
            sp["network"] = ask("Network (blank = default bridge, 'host', or an existing network name)",
                                sp.get("network", ""))
            sp["extra"] = shlex.split(ask("Extra docker run options (e.g. --memory 512m --user 1000:1000)",
                                          shlex.join(sp.get("extra", []))))
            sp["command"] = shlex.split(ask("Command (blank = image default)", shlex.join(sp.get("command", []))))

            print("\n\033[1mCommand:\033[0m\n" + spec_run_text(sp) + "\n")
            choice = ask("[r]un it, [e]dit answers, save as [c]ompose project instead, [q]uit", "r").lower()[:1]
            if choice == "e":
                continue
            if choice == "c":
                return sp
            if choice != "r":
                raise Cancel()
            rc = self.host.interactive(spec_run_argv(sp))
            if rc == 0:
                print("\nContainer %s started." % (sp["name"] or ""))
                pause()
                return None
            if not ask_yn("\ndocker run failed (exit %d). Edit and try again?" % rc):
                return None

    def run_pasted(self):
        with self.suspended():
            try:
                print("\n\033[1mPaste a docker run command\033[0m (lines ending in \\ continue; Ctrl-C cancels)\n")
                parts = []
                while True:
                    line = ask(">" if not parts else " ").rstrip()
                    if line.endswith("\\"):
                        parts.append(line[:-1])
                        continue
                    parts.append(line)
                    break
                script = " ".join(parts).strip()
                try:
                    toks = shlex.split(script)
                except ValueError as e:
                    print("Could not parse: %s" % e)
                    return pause()
                rest = toks[1:] if toks[:1] == ["sudo"] else toks
                if rest[:2] == ["docker", "run"]:
                    opts = rest[2:]
                elif rest[:3] == ["docker", "container", "run"]:
                    opts = rest[3:]
                else:
                    print("That does not start with 'docker run'.")
                    return pause()
                detached = any(re.fullmatch(r"-[a-zA-Z]*d[a-zA-Z]*", t) or t in ("--detach", "--detach=true")
                               for t in opts)
                interactive = any(re.fullmatch(r"-[a-zA-Z]*[it][a-zA-Z]*", t) for t in opts)
                if not detached and not interactive and ask_yn("Add -d so it runs in the background?"):
                    script = re.sub(r"^(\s*(?:sudo\s+)?docker\s+(?:container\s+)?run)\b", r"\1 -d", script, count=1)
                print("\n$ " + script + "\n")
                if ask_yn("Run it?"):
                    rc = self.host.interactive(script)
                    print("\n%s" % ("started" if rc == 0 else "exit code %d" % rc))
                    pause()
            except Cancel:
                print("Cancelled.")
        self.refresh_soon()

