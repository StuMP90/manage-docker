def q(s):
    return shlex.quote(str(s))


def trunc(s, n):
    s = str(s)
    if n <= 0 or len(s) <= n:
        return s if n > 0 else ""
    return s[: n - 1] + "…"


def parse_ts(s):
    """Parse Docker's RFC3339Nano timestamps (portable to Python 3.8)."""
    if not s or s.startswith("0001-"):
        return None
    m = re.match(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(\.\d+)?(Z|[+-]\d\d:\d\d)?", s)
    if not m:
        return None
    frac = "." + (m.group(2) or ".")[1:].ljust(6, "0")[:6]
    tz = m.group(3) or "Z"
    try:
        return datetime.fromisoformat(m.group(1) + frac + ("+00:00" if tz == "Z" else tz))
    except ValueError:
        return None


def ago(dt):
    if not dt:
        return "?"
    s = int((datetime.now(timezone.utc) - dt).total_seconds())
    for n, unit in ((86400, "d"), (3600, "h"), (60, "m")):
        if s >= n:
            return "%d%s" % (s // n, unit)
    return "%ds" % max(s, 0)


def json_lines(text):
    out = []
    for line in text.splitlines():
        line = line.strip()
        if line:
            try:
                out.append(json.loads(line))
            except ValueError:
                pass
    return out


def parse_container(d):
    st = d.get("State") or {}
    cfg = d.get("Config") or {}
    hc = d.get("HostConfig") or {}
    labels = cfg.get("Labels") or {}
    rp = hc.get("RestartPolicy") or {}

    ports = []
    for cport, binds in sorted(((d.get("NetworkSettings") or {}).get("Ports") or {}).items()):
        for hp in sorted({b.get("HostPort") for b in binds or [] if b.get("HostPort")}):
            ports.append("%s->%s" % (hp, cport.replace("/tcp", "")))

    state = st.get("Status", "?")
    health = (st.get("Health") or {}).get("Status", "")
    if state == "running":
        status = "Up " + ago(parse_ts(st.get("StartedAt")))
    elif state == "exited":
        status = "Exited(%s) %s ago" % (st.get("ExitCode"), ago(parse_ts(st.get("FinishedAt"))))
    elif state == "restarting":
        status = "Restarting (exit %s)" % st.get("ExitCode")
    else:
        status = state.capitalize()
    if health and state == "running":
        status += " (%s)" % health

    policy = rp.get("Name") or "no"
    if policy == "on-failure" and rp.get("MaximumRetryCount"):
        policy += ":%d" % rp["MaximumRetryCount"]

    return {
        "id": d.get("Id", "")[:12],
        "name": d.get("Name", "").lstrip("/"),
        "image": cfg.get("Image", ""),
        "image_id": d.get("Image", ""),
        "state": state,
        "health": health,
        "exit_code": st.get("ExitCode", 0),
        "status": status,
        "restart": policy,
        "restart_count": d.get("RestartCount", 0),
        "ports": ports,
        "project": labels.get("com.docker.compose.project", ""),
        "service": labels.get("com.docker.compose.service", ""),
        "wd": labels.get("com.docker.compose.project.working_dir", ""),
        "files": [f for f in labels.get("com.docker.compose.project.config_files", "").split(",") if f],
        "raw": d,
    }


# ------------------------------------------------------------- container specs
# A "spec" is a plain dict describing a container; it can be rendered as a
# `docker run` command or as a compose file.

def spec_from_inspect(d, img_cfg):
    cfg = d.get("Config") or {}
    hc = d.get("HostConfig") or {}
    rp = hc.get("RestartPolicy") or {}
    restart = rp.get("Name") or "no"
    if restart == "on-failure" and rp.get("MaximumRetryCount"):
        restart += ":%d" % rp["MaximumRetryCount"]

    ports = []
    for cport, binds in sorted((hc.get("PortBindings") or {}).items()):
        cp = cport[:-4] if cport.endswith("/tcp") else cport
        for b in binds or [{}]:
            ip, hp = b.get("HostIp") or "", b.get("HostPort") or ""
            ports.append(((ip + ":") if ip else "") + ((hp + ":") if hp else "") + cp)

    volumes = []
    for m in d.get("Mounts") or []:
        ro = "" if m.get("RW", True) else ":ro"
        if m.get("Type") == "bind":
            volumes.append("%s:%s%s" % (m.get("Source"), m.get("Destination"), ro))
        elif m.get("Type") == "volume" and not re.fullmatch(r"[0-9a-f]{64}", m.get("Name", "")):
            volumes.append("%s:%s%s" % (m.get("Name"), m.get("Destination"), ro))

    img_env = set(img_cfg.get("Env") or [])
    net = hc.get("NetworkMode") or ""
    entry = cfg.get("Entrypoint")
    cmd = cfg.get("Cmd")
    return {
        "name": d.get("Name", "").lstrip("/"),
        "service": (cfg.get("Labels") or {}).get("com.docker.compose.service", ""),
        "image": cfg.get("Image", ""),
        "restart": restart,
        "ports": ports,
        "volumes": volumes,
        "env": [e for e in cfg.get("Env") or [] if e not in img_env],
        "network": "" if net in ("default", "bridge") or net.startswith("container:") else net,
        "privileged": bool(hc.get("Privileged")),
        "cap_add": hc.get("CapAdd") or [],
        "devices": ["%s:%s" % (x.get("PathOnHost"), x.get("PathInContainer")) for x in hc.get("Devices") or []],
        "extra_hosts": hc.get("ExtraHosts") or [],
        "entrypoint": entry if entry and entry != img_cfg.get("Entrypoint") else None,
        "command": cmd if cmd and cmd != img_cfg.get("Cmd") else [],
        "extra": [],
    }


def spec_run_groups(sp):
    """`docker run` argv as groups of tokens (one group per display line)."""
    g = [["docker", "run", "-d"]]
    if sp.get("name"):
        g.append(["--name", sp["name"]])
    if sp.get("restart") and sp["restart"] != "no":
        g.append(["--restart", sp["restart"]])
    for flag, key in (("-p", "ports"), ("-v", "volumes"), ("-e", "env"), ("--cap-add", "cap_add"),
                      ("--device", "devices"), ("--add-host", "extra_hosts")):
        for v in sp.get(key) or []:
            g.append([flag, v])
    if sp.get("network"):
        g.append(["--network", sp["network"]])
    if sp.get("privileged"):
        g.append(["--privileged"])
    cmd = list(sp.get("command") or [])
    if sp.get("entrypoint"):
        g.append(["--entrypoint", sp["entrypoint"][0]])
        cmd = list(sp["entrypoint"][1:]) + cmd
    if sp.get("extra"):
        g.append(list(sp["extra"]))
    g.append([sp["image"]] + cmd)
    return g


def spec_run_argv(sp):
    return [t for grp in spec_run_groups(sp) for t in grp]


def spec_run_text(sp):
    return " \\\n    ".join(shlex.join(grp) for grp in spec_run_groups(sp))


def slug(s):
    return re.sub(r"[^a-z0-9_-]+", "-", s.lower()).strip("-_") or "app"


def spec_compose(sp):
    def y(s):  # JSON strings are valid YAML; `$` must be doubled for compose
        return json.dumps(str(s).replace("$", "$$"))

    svc = slug(sp.get("service") or sp.get("name") or sp["image"].split("/")[-1].split(":")[0])
    out = ["services:", "  %s:" % svc, "    image: %s" % y(sp["image"])]
    if sp.get("name"):
        out.append("    container_name: %s" % y(sp["name"]))
    if sp.get("restart") and sp["restart"] != "no":
        out.append("    restart: %s" % sp["restart"])
    net = sp.get("network") or ""
    if net == "host":
        out.append("    network_mode: host")
    for key in ("ports", "volumes", "env", "cap_add", "devices", "extra_hosts"):
        items = sp.get(key) or []
        if items:
            out.append("    %s:" % ("environment" if key == "env" else key))
            out += ["      - %s" % y(v) for v in items]
    if sp.get("privileged"):
        out.append("    privileged: true")
    if sp.get("entrypoint"):
        out.append("    entrypoint: [%s]" % ", ".join(y(v) for v in sp["entrypoint"]))
    if sp.get("command"):
        out.append("    command: [%s]" % ", ".join(y(v) for v in sp["command"]))
    if net and net not in ("host", "none"):
        out += ["    networks:", "      - %s" % y(net), "networks:", "  %s:" % y(net), "    external: true"]
    # Named volumes must be declared; `name:` keeps the exact name, so existing data is reused.
    named = sorted({v.split(":")[0] for v in sp.get("volumes") or []
                    if not v.startswith(("/", ".", "~")) and ":" in v})
    if named:
        out.append("volumes:")
        for v in named:
            out += ["  %s:" % y(v), "    name: %s" % y(v)]
    if sp.get("extra"):
        out.insert(0, "# NOT converted (add by hand): %s" % shlex.join(sp["extra"]))
    return "\n".join(out) + "\n"


# ------------------------------------------------------------------ host access

class Host:
    """Runs commands on this machine."""

    def __init__(self):
        self.label = socket.gethostname()

    @staticmethod
    def _argv(cmd):
        return cmd if isinstance(cmd, list) else ["sh", "-c", cmd]

    def run(self, cmd, input=None, timeout=60):
        """Run a command (argv list, or shell script string); return (rc, stdout, stderr)."""
        kw = {"input": input} if input is not None else {"stdin": subprocess.DEVNULL}
        try:
            p = subprocess.run(self._argv(cmd), capture_output=True, text=True,
                               errors="replace", timeout=timeout, **kw)
            return p.returncode, p.stdout, p.stderr
        except subprocess.TimeoutExpired:
            return 124, "", "timed out after %ss" % timeout
        except OSError as e:
            return 127, "", str(e)

    def interactive(self, cmd):
        """Run attached to the terminal. Ctrl-C goes to the command, not to us."""
        p = subprocess.Popen(self._argv(cmd))
        while True:
            try:
                return p.wait()
            except KeyboardInterrupt:
                continue

    def write_file(self, path, content):
        return self.run("mkdir -p %s && cat > %s" % (q(os.path.dirname(path) or "."), q(path)), input=content)


# --------------------------------------------------------- plain-terminal input

class Cancel(Exception):
    pass


def ask(label, default="", required=False):
    while True:
        try:
            s = input("%s%s: " % (label, " [%s]" % default if default else "")).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            raise Cancel()
        s = s or default
        if s or not required:
            return s


def ask_yn(label, default=True):
    s = ask(label + (" [Y/n]" if default else " [y/N]")).lower()
    return default if not s else s.startswith("y")


def ask_list(label, items):
    items = list(items)
    print(label + ":")

    def show():
        for i, it in enumerate(items, 1):
            print("    %d. %s" % (i, it))
    show()
    while True:
        s = ask("  add one (blank = done, -N removes #N)")
        if not s:
            return items
        if re.fullmatch(r"-\d+", s):
            n = int(s[1:])
            if 1 <= n <= len(items):
                items.pop(n - 1)
            show()
        else:
            items.append(s)


def read_pasted(prompt):
    print(prompt + "\n(finish with a line containing only EOF, or Ctrl-D)")
    lines = []
    while True:
        try:
            line = input()
        except EOFError:
            break
        except KeyboardInterrupt:
            print()
            raise Cancel()
        if line.strip() == "EOF":
            break
        lines.append(line)
    return "\n".join(lines) + "\n"


def edit_text(text, suffix=".yaml"):
    """Edit text in the local $VISUAL/$EDITOR. Returns None if no editor is available."""
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or next(
        (e for e in ("nano", "vim", "vi") if shutil.which(e)), None)
    if not editor:
        return None
    fd, path = tempfile.mkstemp(suffix=suffix, prefix="dockman-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        subprocess.call(shlex.split(editor) + [path])
        with open(path) as f:
            return f.read()
    finally:
        os.unlink(path)


def pause():
    try:
        input("\n[Enter] to return ")
    except (EOFError, KeyboardInterrupt):
        pass


