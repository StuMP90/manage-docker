    def image_dates(self, ids):
        """{full image id: (built, pulled)}; pulled is None when Docker has no record of it."""
        ids = sorted(set(ids))
        rc, out, _ = self.host.run(["docker", "image", "inspect"] + ids) if ids else (1, "", "")
        dates = {}
        for im in json.loads(out or "[]") if rc == 0 else []:
            dates[im["Id"]] = (parse_ts(im.get("Created", "")),
                               parse_ts((im.get("Metadata") or {}).get("LastTagTime", "")))
        return dates

    def images_screen(self):
        while True:
            out = self.capture(["docker", "image", "ls", "--no-trunc", "--format", "{{json .}}"])
            if out is None:
                return
            imgs = json_lines(out)
            dates = self.image_dates(im["ID"] for im in imgs)
            used = {c["image_id"][7:19] for c in self.containers}
            for im in imgs:
                im["ref"] = im["ID"] if im.get("Repository") == "<none>" else "%s:%s" % (im["Repository"], im["Tag"])
            fmt = "%-50s %-12s %9s  %-8s %-8s %s"
            rows = [fmt % (trunc(im["ref"], 50), im["ID"][7:19], im.get("Size", ""),
                           *(ago(d) if d else "-" for d in dates.get(im["ID"], (None, None))),
                           "in use" if im["ID"][7:19] in used else "")
                    for im in imgs]
            k, i = self.pick("Images", fmt % ("IMAGE", "ID", "SIZE", "BUILT", "PULLED", ""),
                             rows, "Enter actions  r run  u pull/update  d remove  i inspect  h history  "
                                   "P pull new  q back")
            if k is None:
                return
            if k == "P":
                ref = self.prompt("Image to pull:")
                if ref:
                    self.run_term(["docker", "pull", ref])
                continue
            if i is None:
                continue
            im = imgs[i]
            if k == "\n":
                k = self.menu(im["ref"], [("r", "Run a new container from it"), ("u", "Pull / update this tag"),
                                          ("d", "Remove"), ("i", "Inspect"), ("h", "Layer history")])
            if k == "r":
                self.run_wizard({"image": im["ref"]})
            elif k == "u":
                if im.get("Repository") == "<none>":
                    self.flash("Untagged image; nothing to pull", err=True)
                else:
                    self.run_term(["docker", "pull", im["ref"]])
            elif k == "d" and self.confirm("Remove image %s?" % im["ref"]):
                self.run_term(["docker", "image", "rm", im["ref"]])
            elif k in ("i", "h"):
                cmd = ["docker", "image", "inspect", im["ID"]] if k == "i" else \
                      ["docker", "image", "history", "--no-trunc", im["ID"]]
                out = self.capture(cmd)
                if out is not None:
                    self.page(out, im["ref"])

